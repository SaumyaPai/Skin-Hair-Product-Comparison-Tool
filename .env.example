# Copy this file to a new file called .env and fill in your own values.
# Never share .env or upload it anywhere.

# Your free Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which Gemini model to use. Check AI Studio for a current free-tier "Flash" model.
GEMINI_MODEL=gemini-3.8-flash

# Open Beauty Facts asks apps to name themselves. Keep it generic, no personal details needed.
OBF_USER_AGENT=SkincareCompare/0.1 (personal learning project)

# ---- Backup AI (all optional) ----
# Lighter Gemini models to try, in order, when the main one is busy (comma separated).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash

# A second free AI provider, used when every Gemini model is busy.
# Free key from https://console.groq.com/keys . Leave empty to skip Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Offline photo reading (Tesseract). Only change this if you installed it somewhere else.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Which AI goes first: groq (default) or gemini. A busy AI is skipped for this many seconds.
AI_FIRST=groq
AI_COOLDOWN_SECONDS=300
